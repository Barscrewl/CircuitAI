{
  "stop_minute": 3,
  "expect": [
    {
      "key": "intercept",
      "pattern": "\\[CommanderT3\\].*action=fire concealed=1",
      "scope": "any",
      "by_minute": 2.5
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "\\[INVARIANT\\]",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    }
  ]
}
