{
  "stop_minute": 8,
  "expect": [
    {"key":"loaded","pattern":"\\[AirArena\\] event=loaded","scope":"any","by_minute":1},
    {"key":"launch","pattern":"\\[AirArena\\] event=launch","scope":"any","by_minute":3},
    {"key":"exhausted","pattern":"WAVE: operation exhausted","scope":"any","by_minute":7},
    {"key":"wipe","pattern":"\\[AIR\\]\\[EscortScout\\] wipe op=\\d+ bombersLaunched=[1-9]\\d* escorts=[1-9]","scope":"any","by_minute":7},
    {"key":"t1-scout","pattern":"\\[AIR\\]\\[EscortScout\\] fighter=\\d+ def=(armfig|corveng|legfig) .*point=","scope":"any","by_minute":7,"after_key":"wipe"},
    {"key":"t2-scout","pattern":"\\[AIR\\]\\[EscortScout\\] fighter=\\d+ def=(armhawk|corvamp|legvenator|legafigdef) .*point=","scope":"any","by_minute":7,"after_key":"wipe"},
    {"key":"dispatch","pattern":"\\[AIR\\]\\[EscortScout\\] dispatch fighter=\\d+","scope":"any","by_minute":7,"after_key":"wipe"},
    {"key":"arrived","pattern":"\\[AIR\\]\\[EscortScout\\] released fighter=\\d+ reason=arrived","scope":"any","by_minute":8,"after_key":"dispatch"}
  ],
  "forbid": [
    {"key":"script","pattern":": ERR\\s+:|SCRIPT CRASH|Lib exception","scope":"any"},
    {"key":"invariant","pattern":"INVARIANT|\\[AirOrders\\] ERROR","scope":"any"},
    {"key":"scout-invariant","pattern":"INV-202","scope":"any"},
    {"key":"fixture","pattern":"\\[AirArena\\] event=error|Removed widget: AIR combat arena|Error in.*air_arena","scope":"any"},
    {"key":"crash","pattern":"Access violation|has crashed|Fatal:","scope":"any"}
  ]
}
